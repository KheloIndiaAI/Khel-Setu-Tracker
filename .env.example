# Copy to .env and fill in. Never commit .env.
# Prisma CLI reads .env (not .env.local), so keep DATABASE_URL here for host-side prisma commands.

# Host-side (npm run dev, npx prisma ...): Postgres from `docker compose up -d db`
DATABASE_URL=postgresql://khelsetu:khelsetu_password@localhost:5432/khelsetu?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (https://your-domain in production)
AUTH_URL=http://localhost:3000

# Production only
POSTGRES_PASSWORD=
APP_DOMAIN=
# Bearer token for the nightly snapshot job (/api/cron/snapshot)
CRON_SECRET=
